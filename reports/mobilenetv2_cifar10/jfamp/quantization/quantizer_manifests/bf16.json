  "selftests": [
    {
      "test": "bf16: 1.0 -> 0x3F80, -2.0 -> 0xC000, float32 max saturates to 0x7F7F, 2^-133 -> 0x0001 (smallest subnormal), 2^-149 rounds to 0, -0.0 -> 0x8000",
      "passed": true,
      "detail": "['0x3f80', '0xc000', '0x7f7f', '0x1', '0x0', '0x8000']"
    },
    {
      "test": "bf16: round-to-nearest-even on exact ties (1+2^-8 -> 0x3F80, 1+3*2^-8 -> 0x3F82)",
      "passed": true,
      "detail": ""
    },
    {
      "test": "bf16: the all-ones exponent gives 256 inf/NaN words (2 infinities, 254 NaN); the other 65,280 words are finite",
      "passed": true,
      "detail": ""
    },
    {
      "test": "bf16: decode->encode returns the same word for every finite word (-0 and +0 included)",
      "passed": true,
      "detail": ""
    },
    {
      "test": "bf16: encoder equals torch.bfloat16 casting on 200k values (N(0, 0.01) and log-uniform 1e-30..1e30)",
      "passed": true,
      "detail": ""
    }
  ],
  "selftests_all_passed": true,
